# Response headers for the Worker's static assets. Cloudflare reads this file at deploy time; it isn't served.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Images keep their file names when replaced, so cache them for a week rather than forever.
# HTML, CSS and JS keep Cloudflare's default, which revalidates on every visit.
/assets/*
  Cache-Control: public, max-age=604800
